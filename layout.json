{
  "_comment": "Zentrale UI-Definition. Nach Aenderungen: python tools/generate_ui.py && esphome run main.yaml. Grid: [spalte, zeile, spaltenanzahl?, zeilenanzahl?]. Content-Bereich: y 70-420 (zwischen Header und Footer).",

  "content": {"x": 30, "y": 70, "width": 740},
  "grid": {"columns": 2, "row_height": 64, "gap": 8},

  "pages": [
    {
      "id": "main",
      "title": "Main",
      "grid": {"columns": 4},
      "widgets": [
        {"type": "thermostat", "key": "thermostat", "entity": "climate.thermostat", "current_entity": "sensor.wohnzimmer_echo_dot_temperatur_2", "min": 15, "max": 25, "grid": [0, 0, 2, 5]},

        {"type": "clock", "key": "time_display", "grid": [2, 0, 2, 2]},

        {"type": "sensor-value", "entity": "weather.forecast_home", "attribute": "temperature", "key": "weather_temperature", "name": "Aussen", "format": "%.1f °C", "grid": [2, 2]},
        {"type": "sensor-value", "entity": "weather.forecast_home", "attribute": "humidity", "key": "weather_humidity", "name": "Feuchte", "format": "%.0f %%", "grid": [3, 2]},
        {"type": "light", "entity": "light.ambiente", "key": "ambiente", "name": "Ambiente", "grid": [2, 3]}

      ]
    },

    {
      "id": "light",
      "title": "Light",
      "grid": {"columns": 3},
      "widgets": [
        {"type": "light", "entity": "light.wand_links", "key": "wand_links", "name": "Wand links", "grid": [0, 0]},
        {"type": "light", "entity": "light.wand_mitte", "key": "wand_mitte", "name": "Wand Mitte", "grid": [1, 0]},
        {"type": "light", "entity": "light.wohnzimmer_wand_rechts", "key": "wand_rechts", "name": "Wand rechts", "grid": [2, 0]},
        {"type": "light", "entity": "light.wohnzimmer_couch", "key": "tuercouch", "name": "Couch", "grid": [0, 1]},
        {"type": "light", "entity": "light.licht_schrank_mitte", "key": "schrank_mitte", "name": "Schrank mitte", "grid": [0, 2]},
        {"type": "light", "entity": "light.tz3000_el5kt5im_ts0502a", "key": "schrank_links", "name": "Schrank links", "grid": [1, 2]},
        {"type": "light", "entity": "light.wohnzimmer_esstisch", "key": "esstisch", "name": "Esstisch", "grid": [2, 2]}
      ]
    },

    {
      "id": "rolladen",
      "title": "Rolladen",
      "widgets": [
        {"type": "cover", "entity": "cover.rollladen_wz_rechts", "key": "west", "name": "West", "grid": [0, 0]},
        {"type": "cover", "entity": "cover.rollladen_wz_links", "key": "terrasse", "name": "Terrasse", "grid": [0, 1]},
        {"type": "cover", "entity": "cover.rollladen_wz_schiebetur", "key": "schiebetuer", "name": "Schiebetür", "grid": [1, 1]},
        {"type": "cover", "entity": "cover.rollladen_kuche", "key": "kueche", "name": "Küche", "grid": [1, 0]}

      ]
    },

    {
      "id": "settings",
      "title": "Settings",
      "grid": {"columns": 1},
      "widgets": [
        {"type": "backlight-slider", "key": "brightness", "name": "Display-Helligkeit", "grid": [0, 0]},
        {"type": "number-slider", "key": "timeout", "name": "Display-Timeout", "bind": "display_timeout", "unit": "s", "min": 10, "max": 180, "grid": [0, 1]}
      ]
    }
  ]
}
